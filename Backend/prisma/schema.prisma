generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXAM_PASSED
  EXAM_FAILED
  INTERVIEW_SCHEDULED
  INTERVIEW_PASSED
  INTERVIEW_FAILED
  CONVERTED
}

enum Year {
  FIRST
  SECOND
  THIRD
  FOURTH
}

// ─── User (Members + Admins) ───────────────────────────────────────────────

enum SiteRole {
  MEMBER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?
  photo     String?
  batch     String?
  instagram String?
  linkedin  String?
  github    String?
  siteRole  SiteRole @default(MEMBER)
  orgRole   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  notifications      Notification[]
  replies            Reply[]
  announcements      Announcement[]
  events             Event[]
  projects           Project[]
  passwordResetToken PasswordResetToken?
  application        Application?
}

// ─── OAuth Accounts ────────────────────────────────────────────────────────

model Account {
  id                Int       @id @default(autoincrement())
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())

  @@unique([provider, providerAccountId])
}

// ─── Sessions ──────────────────────────────────────────────────────────────

model Session {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())
}

// ─── Password Reset ────────────────────────────────────────────────────────

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Invite Token ──────────────────────────────────────────────────────────

model InviteToken {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Application ───────────────────────────────────────────────────────────

model Application {
  id         Int               @id @default(autoincrement())
  name       String
  email      String            @unique
  password   String
  rollNumber String            @unique
  branch     String
  year       Year
  batch      String?
  reason     String
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id])

  admitCard        AdmitCard?
  interviewInvite  InterviewInvite?
}

// ─── Admit Card ────────────────────────────────────────────────────────────

model AdmitCard {
  id            Int         @id @default(autoincrement())
  applicationId Int         @unique
  application   Application @relation(fields: [applicationId], references: [id])
  examDate      DateTime
  venue         String?
  examScore     Float?
  maxScore      Float?
  isPassed      Boolean?
  issuedAt      DateTime    @default(now())
}

// ─── Interview Invite ──────────────────────────────────────────────────────

model InterviewInvite {
  id              Int         @id @default(autoincrement())
  applicationId   Int         @unique
  application     Application @relation(fields: [applicationId], references: [id])
  date            DateTime
  venue           String?
  interviewScore  Float?
  maxScore        Float?
  isPassed        Boolean?
  feedback        String?
  issuedAt        DateTime    @default(now())
}

// ─── Events ────────────────────────────────────────────────────────────────

model Event {
  id          Int         @id @default(autoincrement())
  name        String
  title       String
  description String
  date        DateTime?
  venue       String?
  isActive    Boolean     @default(false)  // ← add this
  createdAt   DateTime    @default(now())

  authorId    Int
  author      User        @relation(fields: [authorId], references: [id])
  items       EventItem[]
}

model EventItem {
  id          Int    @id @default(autoincrement())
  title       String // ← add this
  photo       String
  explanation String
  eventId     Int
  event       Event  @relation(fields: [eventId], references: [id])
}
// ─── Projects ──────────────────────────────────────────────────────────────

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String
  githubUrl   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  authorId Int
  author   User @relation(fields: [authorId], references: [id])
}

// ─── Announcements ─────────────────────────────────────────────────────────

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  authorId Int
  author   User @relation(fields: [authorId], references: [id])
}

// ─── Contact Messages ──────────────────────────────────────────────────────

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  notifications Notification[]
  replies       Reply[]
}

// ─── Notifications ─────────────────────────────────────────────────────────

model Notification {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation(fields: [userId], references: [id])
  messageId Int
  message   ContactMessage @relation(fields: [messageId], references: [id])
  isRead    Boolean        @default(false)
  createdAt DateTime       @default(now())
}

// ─── Replies ───────────────────────────────────────────────────────────────

model Reply {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation(fields: [userId], references: [id])
  messageId Int
  message   ContactMessage @relation(fields: [messageId], references: [id])
  content   String
  createdAt DateTime       @default(now())
}